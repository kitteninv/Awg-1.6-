}

health_text() {
    local DOCKER="🔴"
    local AWG="🔴"
    local TIMER="🔴"
    local BOT="🔴"

    docker inspect "$CONTAINER" >/dev/null 2>&1 && DOCKER="🟢"

    docker exec "$CONTAINER" awg show awg0 >/dev/null 2>&1 &&
        AWG="🟢"

    systemctl is-active --quiet awg-telegram-monitor.timer &&
        TIMER="🟢"

    systemctl is-active --quiet awg-telegram-bot.service &&
        BOT="🟢"

    # CPU — расчёт по /proc/stat, 2 замера
    local CPU
    CPU=$(awk '/^cpu / {
        total=$2+$3+$4+$5+$6+$7+$8+$9+$10
        idle=$5+$6
        print total, idle
        exit
    }' /proc/stat)

    local T1 I1 T2 I2
    T1=$(echo "$CPU" | awk '{print $1}')
    I1=$(echo "$CPU" | awk '{print $2}')

    sleep 1

    CPU=$(awk '/^cpu / {
        total=$2+$3+$4+$5+$6+$7+$8+$9+$10
        idle=$5+$6
        print total, idle
        exit
    }' /proc/stat)

    T2=$(echo "$CPU" | awk '{print $1}')
    I2=$(echo "$CPU" | awk '{print $2}')

    if [ -n "$T1" ] && [ -n "$I1" ] && [ -n "$T2" ] && [ -n "$I2" ] &&
       [ "$T2" -gt "$T1" ]; then

        local DT DI
        DT=$((T2 - T1))
        DI=$((I2 - I1))

        CPU=$(awk -v dt="$DT" -v di="$DI" \
            'BEGIN {
                if (dt > 0)
                    printf "%.0f", (100 * (dt-di) / dt)
                else
                    print "?"
            }')
    else
        CPU="?"
    fi

    local RAM
    RAM=$(free 2>/dev/null |
        awk '/Mem:/ {printf "%.0f", $3/$2*100}')

    [ -z "$RAM" ] && RAM="?"

    local DISK
    DISK=$(df -P / 2>/dev/null |
        awk 'NR==2 {gsub("%","",$5); print $5}')

    [ -z "$DISK" ] && DISK="?"

    local UPTIME
    UPTIME=$(uptime -p 2>/dev/null || echo "unknown")

    cat <<TEXT
🖥 SERVER HEALTH

Docker: ${DOCKER}
AWG: ${AWG}
Monitor: ${TIMER}
Telegram Bot: ${BOT}

CPU: ${CPU}%
RAM: ${RAM}%
Disk: ${DISK}%

Uptime: ${UPTIME}
TEXT
}

