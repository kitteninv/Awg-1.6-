client_details() {
    local IP="$1"

    # Обновляем общий кэш максимум раз в AWG_CACHE_TTL секунд
    refresh_awg_cache

    local NAME
    NAME="${CACHE_NAME[$IP]:-$IP}"

    local STATUS
    STATUS=$(get_status "$IP")

    local ICON
    ICON=$(status_icon "$STATUS")

    local STATUS_LABEL
    STATUS_LABEL=$(status_name "$STATUS")

    local RX_BYTES="${CACHE_RX[$IP]:-0}"
    local TX_BYTES="${CACHE_TX[$IP]:-0}"
    local HS="${CACHE_HS[$IP]:-0}"

    # Форматирование трафика
    local RX="0"
    local TX="0"

    if [ "$RX_BYTES" != "0" ] && [ -n "$RX_BYTES" ]; then
        RX="$RX_BYTES"
    fi

    if [ "$TX_BYTES" != "0" ] && [ -n "$TX_BYTES" ]; then
        TX="$TX_BYTES"
    fi

    # Переводим байты в удобный вид
    format_bytes() {
        local B="${1:-0}"

        if ! [[ "$B" =~ ^[0-9]+$ ]]; then
            echo "$B"
            return
        fi

        if [ "$B" -ge 1073741824 ]; then
            awk -v b="$B" 'BEGIN {printf "%.2f GiB", b/1073741824}'
        elif [ "$B" -ge 1048576 ]; then
            awk -v b="$B" 'BEGIN {printf "%.2f MiB", b/1048576}'
        elif [ "$B" -ge 1024 ]; then
            awk -v b="$B" 'BEGIN {printf "%.2f KiB", b/1024}'
        else
            printf '%s B' "$B"
        fi
    }

    RX=$(format_bytes "$RX_BYTES")
    TX=$(format_bytes "$TX_BYTES")

    local HANDSHAKE="нет"

    if [ -n "$HS" ] && [ "$HS" != "0" ]; then
        local NOW
        local AGE

        NOW=$(date +%s)
        AGE=$((NOW - HS))

        if [ "$AGE" -lt 0 ]; then
            AGE=0
        fi

        if [ "$AGE" -lt 60 ]; then
            HANDSHAKE="${AGE} сек. назад"
        elif [ "$AGE" -lt 3600 ]; then
            HANDSHAKE="$((AGE / 60)) мин. назад"
        elif [ "$AGE" -lt 86400 ]; then
            HANDSHAKE="$((AGE / 3600)) ч. назад"
        else
            HANDSHAKE="$((AGE / 86400)) дн. назад"
        fi
    fi

    cat <<TEXT
👤 ${NAME}

IP: ${IP}
Статус: ${ICON} ${STATUS_LABEL}

RX: ${RX}
TX: ${TX}
Handshake: ${HANDSHAKE}
TEXT
}


