#!/bin/bash

set -u

VERSION="1.6"

CONFIG="/etc/awg-monitor.conf"
STATE_DIR="/var/lib/awg-monitor"
OFFSET_FILE="${STATE_DIR}/bot-offset"

CONTAINER="amnezia-awg2"
AWG_DIR="/opt/amnezia/awg"

source "$CONFIG"

mkdir -p "$STATE_DIR"

API="https://api.telegram.org/bot${BOT_TOKEN}"

api() {
    curl -4 -sS --connect-timeout 5 --max-time 35 "$@"
}

json_escape() {
    printf '%s' "$1" |
        sed ':a;N;$!ba;s/\\/\\\\/g;s/"/\\"/g;s/\r//g;s/\n/\\n/g'
}

send_message() {
    local CHAT="$1"
    local TEXT="$2"

    api -X POST "${API}/sendMessage" \
        -d "chat_id=${CHAT}" \
        --data-urlencode "text=${TEXT}" \
        >/dev/null
}

send_menu() {
    local CHAT="$1"

    local MARKUP='{
        "inline_keyboard":[
            [
                {"text":"👥 Клиенты","callback_data":"clients"},
                {"text":"📈 Трафик","callback_data":"traffic"}
            ],
            [
                {"text":"📊 Статус","callback_data":"status"}
            ],
            [
                {"text":"🔴 Проблемы","callback_data":"problems"},
                {"text":"🖥 Сервер","callback_data":"health"},
                {"text":"🔄 Обновить","callback_data":"menu"}
            ]
        ]
    }'

    api -X POST "${API}/sendMessage" \
        -d "chat_id=${CHAT}" \
        --data-urlencode "text=⚡ AMNEZIA AWG MANAGER v${VERSION}" \
        --data-urlencode "reply_markup=${MARKUP}" \
        >/dev/null
}

edit_message() {
    local CHAT="$1"
    local MESSAGE_ID="$2"
    local TEXT="$3"
    local MARKUP="${4:-}"

    if [ -n "$MARKUP" ]; then
        api -X POST "${API}/editMessageText" \
            -d "chat_id=${CHAT}" \
            -d "message_id=${MESSAGE_ID}" \
            --data-urlencode "text=${TEXT}" \
            --data-urlencode "reply_markup=${MARKUP}" \
        >/dev/null
    else
        api -X POST "${API}/editMessageText" \
            -d "chat_id=${CHAT}" \
            -d "message_id=${MESSAGE_ID}" \
            --data-urlencode "text=${TEXT}" \
        >/dev/null
    fi
}

answer_callback() {
    local QUERY_ID="$1"

    api -X POST "${API}/answerCallbackQuery" \
        -d "callback_query_id=${QUERY_ID}" \
        >/dev/null
}

# Кэш данных AWG для ускоренной работы бота
AWG_CACHE_TIME=0
AWG_CACHE_TTL=3

declare -A CACHE_NAME
declare -A CACHE_PUB
declare -A CACHE_IP
declare -A CACHE_KEY
declare -A CACHE_HS
declare -A CACHE_RX
declare -A CACHE_TX
declare -A CACHE_USED

refresh_awg_cache() {
    local NOW
    NOW=$(date +%s)

    if [ "$((NOW - AWG_CACHE_TIME))" -lt "$AWG_CACHE_TTL" ]; then
        return
    fi

    AWG_CACHE_TIME="$NOW"

    CACHE_NAME=()
    CACHE_PUB=()
    CACHE_IP=()
    CACHE_KEY=()
    CACHE_HS=()
    CACHE_RX=()
    CACHE_TX=()
    CACHE_USED=()

    #
    # 1. Один docker exec:
    #    awg0.conf + clientsTable
    #
    local DATA
    DATA=$(docker exec "$CONTAINER" sh -c \
        'printf "__AWG_CONF__\n"; cat /opt/amnezia/awg/awg0.conf; printf "\n__CLIENTS_TABLE__\n"; cat /opt/amnezia/awg/clientsTable' \
        2>/dev/null)

    #
    # Сначала строим IP <-> PublicKey из awg0.conf
    #
    local MODE=""
    local PUB=""
    local IP=""
    local NAME=""

    while IFS= read -r line; do

        if [ "$line" = "__AWG_CONF__" ]; then
            MODE="AWG"
            PUB=""
            IP=""
            continue
        fi

        if [ "$line" = "__CLIENTS_TABLE__" ]; then
            MODE="TABLE"
            PUB=""
            IP=""
            NAME=""
            continue
        fi

        if [ "$MODE" = "AWG" ]; then

            if [[ "$line" =~ ^PublicKey[[:space:]]*=[[:space:]]*(.+)$ ]]; then
                PUB="${BASH_REMATCH[1]}"
                continue
            fi

            if [[ "$line" =~ ^AllowedIPs[[:space:]]*=[[:space:]]*(10\.8\.1\.[0-9]+)/32$ ]]; then
                IP="${BASH_REMATCH[1]}"

                if [ -n "$PUB" ]; then
                    CACHE_PUB["$IP"]="$PUB"
                    CACHE_IP["$PUB"]="$IP"
                fi

                continue
            fi

        elif [ "$MODE" = "TABLE" ]; then

            if [[ "$line" =~ \"clientId\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
                PUB="${BASH_REMATCH[1]}"
                IP="${CACHE_IP[$PUB]:-}"
                NAME=""
                continue
            fi

            if [[ "$line" =~ \"allowedIps\"[[:space:]]*:[[:space:]]*\"(10\.8\.1\.[0-9]+)/32\" ]]; then
                IP="${BASH_REMATCH[1]}"
                CACHE_PUB["$IP"]="$PUB"
                CACHE_IP["$PUB"]="$IP"
                continue
            fi

            if [[ "$line" =~ \"allowed_ips\"[[:space:]]*:[[:space:]]*\"(10\.8\.1\.[0-9]+)/32\" ]]; then
                IP="${BASH_REMATCH[1]}"
                CACHE_PUB["$IP"]="$PUB"
                CACHE_IP["$PUB"]="$IP"
                continue
            fi

            if [[ "$line" =~ \"clientName\"[[:space:]]*:[[:space:]]*\"(.*)\" ]]; then
                NAME="${BASH_REMATCH[1]}"
                NAME="${NAME//\\n/ }"
                NAME="$(printf '%s' "$NAME" | sed 's/[[:space:]]*$//')"

                if [ -n "$IP" ]; then
                    CACHE_NAME["$IP"]="$NAME"
                elif [ -n "$PUB" ] && [ -n "${CACHE_IP[$PUB]:-}" ]; then
                    CACHE_NAME["${CACHE_IP[$PUB]}"]="$NAME"
                fi

                continue
            fi

            if [[ "$line" =~ \"latestHandshake\"[[:space:]]*:[[:space:]]*\"(.*)\" ]]; then
                CACHE_USED["$IP"]="YES"
            fi
        fi

    done <<< "$DATA"

    #
    # 2. Один docker exec:
    #    dump содержит сразу:
    #    PublicKey
    #    AllowedIPs
    #    latestHandshake
    #    RX
    #    TX
    #
    local DUMP
    DUMP=$(docker exec "$CONTAINER" awg show awg0 dump 2>/dev/null)

    local FIRST=1
    local KEY PSK ENDPOINT ALLOWED HS RX TX KEEPALIVE

    while read -r KEY PSK ENDPOINT ALLOWED HS RX TX KEEPALIVE; do

        [ -z "$KEY" ] && continue

        # Первая строка dump — параметры интерфейса
        if [ "$FIRST" -eq 1 ]; then
            FIRST=0
            continue
        fi

        [[ "$ALLOWED" != 10.8.1.*"/32" ]] && continue

        IP="${ALLOWED%/32}"

        CACHE_KEY["$IP"]="$KEY"
        CACHE_HS["$IP"]="${HS:-0}"
        CACHE_RX["$IP"]="${RX:-0}"
        CACHE_TX["$IP"]="${TX:-0}"

    done <<< "$DUMP"
}

get_name() {
    local IP="$1"
    echo "${CACHE_NAME[$IP]:-$IP}"
}

get_key() {
    local IP="$1"
    echo "${CACHE_KEY[$IP]:-}"
}

get_handshake() {
    local KEY="$1"

    local IP
    for IP in "${!CACHE_KEY[@]}"; do
        if [ "${CACHE_KEY[$IP]}" = "$KEY" ]; then
            echo "${CACHE_HS[$IP]:-0}"
            return
        fi
    done

    echo "0"
}

get_status() {
    local IP="$1"

    # IP существует в постоянном awg0.conf,
    # но отсутствует в работающем AWG = PAUSED
    if [ -z "${CACHE_PUB[$IP]:-}" ]; then
        echo "NEVER"
        return
    fi

    if [ -z "${CACHE_KEY[$IP]:-}" ]; then
        echo "PAUSED"
        return
    fi

    local HS="${CACHE_HS[$IP]:-0}"

    if [ -z "$HS" ] || [ "$HS" = "0" ]; then
        if [ "${CACHE_USED[$IP]:-}" = "YES" ]; then
            echo "OFF"
        else
            echo "NEVER"
        fi
        return
    fi

    local AGE
    AGE=$(( $(date +%s) - HS ))

    if [ "$AGE" -lt "${OFF_TIMEOUT:-1800}" ]; then
        echo "ACTIVE"
    else
        echo "OFF"
    fi
}


get_clients() {
    # Берём ВСЕХ клиентов из постоянного awg0.conf.
    # Это позволяет видеть даже клиентов, которые ещё ни разу
    # не подключались, а также клиентов, поставленных на паузу.
    docker exec "$CONTAINER" awk '
        /^AllowedIPs[[:space:]]*=/ {
            x=$0
            sub(/^[^=]*=[[:space:]]*/, "", x)

            if (x ~ /^10\.8\.1\.[0-9]+\/32$/) {
                sub(/\/32$/, "", x)
                print x
            }
        }
    ' "$AWG_DIR/awg0.conf" 2>/dev/null | sort -V
}

status_icon() {
    case "$1" in
        ACTIVE) echo "🟢" ;;
        OFF)    echo "🔴" ;;
        NEVER)  echo "⚪" ;;
        PAUSED) echo "🟡" ;;
        *)      echo "⚪" ;;
    esac
}

status_name() {
    case "$1" in
        ACTIVE) echo "ONLINE" ;;
        OFF)    echo "OFFLINE" ;;
        NEVER)  echo "NEVER USED" ;;
        PAUSED) echo "PAUSED" ;;
        *)      echo "UNKNOWN" ;;
    esac
}

clients_markup() {
    local JSON='{"inline_keyboard":['
    local FIRST=1

    while read -r IP; do
        [ -z "$IP" ] && continue

        local NAME
        NAME=$(get_name "$IP")
        [ -z "$NAME" ] && NAME="$IP"

        local STATUS
        STATUS=$(get_status "$IP")

        local ICON
        ICON=$(status_icon "$STATUS")

        local SAFE_NAME
        SAFE_NAME=$(json_escape "$NAME")

        if [ "$FIRST" -eq 0 ]; then
            JSON+=","
        fi

        JSON+="[{\"text\":\"${ICON} ${SAFE_NAME} — ${IP}\",\"callback_data\":\"client:${IP}\"}]"

        FIRST=0
    done < <(get_clients)

    JSON+=',[
        {"text":"🔄 Обновить","callback_data":"clients"},
        {"text":"🏠 Главное меню","callback_data":"menu"}
    ]]}'

    printf '%s' "$JSON"
}

format_bytes() {
    local BYTES="${1:-0}"

    if [ "$BYTES" -ge 1073741824 ]; then
        awk -v b="$BYTES" 'BEGIN {printf "%.2f GB", b/1073741824}'
    elif [ "$BYTES" -ge 1048576 ]; then
        awk -v b="$BYTES" 'BEGIN {printf "%.1f MB", b/1048576}'
    elif [ "$BYTES" -ge 1024 ]; then
        awk -v b="$BYTES" 'BEGIN {printf "%.1f KB", b/1024}'
    else
        echo "${BYTES} B"
    fi
}

traffic_text() {
    local MONTH
    MONTH=$(date +%Y-%m)

    local MONTH_FILE="/var/lib/awg-traffic/${MONTH}.tsv"

    local TEXT="📈 ТРАФИК — ${MONTH}

"
    local TOTAL=0

    [ -f "$MONTH_FILE" ] || {
        TEXT+="Нет данных"
        printf '%s' "$TEXT"
        return
    }

    local TMP
    TMP=$(mktemp)

    while IFS=$'\t' read -r IP TRAFFIC; do
        [ -z "$IP" ] && continue

        TRAFFIC="${TRAFFIC:-0}"
        TOTAL=$((TOTAL + TRAFFIC))

        NAME=$(get_name "$IP")
        [ -z "$NAME" ] && NAME="$IP"

        printf '%020d\t%s\t%s\n' "$TRAFFIC" "$IP" "$NAME" >> "$TMP"
    done < "$MONTH_FILE"

    while IFS=$'\t' read -r SORTED IP NAME; do
        TRAFFIC="${SORTED#0}"
        TRAFFIC="${TRAFFIC:-0}"

        TEXT+="👤 ${NAME}
${IP} — $(format_bytes "$TRAFFIC")

"
    done < <(sort -r "$TMP")

    rm -f "$TMP"

    TEXT+="━━━━━━━━━━━━━━
📊 ВСЕГО: $(format_bytes "$TOTAL")"

    printf '%s' "$TEXT"
}

traffic_markup() {
    printf '%s' '{
        "inline_keyboard":[
            [
                {"text":"🔄 Обновить","callback_data":"traffic"},
                {"text":"📚 Архив","callback_data":"traffic_archive"}
            ],
            [
                {"text":"👥 Клиенты","callback_data":"clients"},
                {"text":"🏠 Главное меню","callback_data":"menu"}
            ]
        ]
    }'
}

traffic_archive_text() {
    local TEXT="📚 АРХИВ ТРАФИКА

"
    local FOUND=0
    local MONTH
    local FILE
    local TOTAL

    # Месяцы — от нового к старому
    for FILE in $(find /var/lib/awg-traffic/archive -maxdepth 1 -type f -name '20??-??.tsv' 2>/dev/null | sort -r); do
        [ -f "$FILE" ] || continue

        MONTH=$(basename "$FILE" .tsv)

        TOTAL=$(awk '{sum += $2} END {printf "%.2f GB", sum/1073741824}' "$FILE")

        TEXT+="📅 ${MONTH}
📊 ${TOTAL}

"

        FOUND=1
    done

    if [ "$FOUND" -eq 0 ]; then
        TEXT+="Архив пока пуст."
    fi

    printf '%s' "$TEXT"
}

traffic_archive_markup() {
    local JSON='{"inline_keyboard":['
    local FIRST=1
    local FILE
    local MONTH

    for FILE in $(find /var/lib/awg-traffic/archive -maxdepth 1 -type f -name '20??-??.tsv' 2>/dev/null | sort -r); do
        [ -f "$FILE" ] || continue

        MONTH=$(basename "$FILE" .tsv)

        if [ "$FIRST" -eq 0 ]; then
            JSON+=','
        fi

        JSON+='[{"text":"📅 '"${MONTH}"'","callback_data":"traffic_archive_month:'"${MONTH}"'"}]'

        FIRST=0
    done

    JSON+='],[
        {"text":"◀️ Назад к трафику","callback_data":"traffic"},
        {"text":"🏠 Главное меню","callback_data":"menu"}
    ]]}'

    printf '%s' "$JSON"
}

traffic_archive_month_text() {
    local MONTH="$1"
    local FILE

    case "$MONTH" in
        20??-??) ;;
        *) printf 'Ошибка месяца'; return 1 ;;
    esac

    if [ -f "/var/lib/awg-traffic/archive/${MONTH}.tsv" ]; then
        FILE="/var/lib/awg-traffic/archive/${MONTH}.tsv"
    elif [ -f "/var/lib/awg-traffic/${MONTH}.tsv" ]; then
        FILE="/var/lib/awg-traffic/${MONTH}.tsv"
    else
        printf '📚 АРХИВ\n\nНет данных за %s' "$MONTH"
        return 0
    fi

    local MON="${MONTH:5:2}"
    local YEAR="${MONTH:0:4}"
    local MONTH_NAME

    case "$MON" in
        01) MONTH_NAME="Январь" ;;
        02) MONTH_NAME="Февраль" ;;
        03) MONTH_NAME="Март" ;;
        04) MONTH_NAME="Апрель" ;;
        05) MONTH_NAME="Май" ;;
        06) MONTH_NAME="Июнь" ;;
        07) MONTH_NAME="Июль" ;;
        08) MONTH_NAME="Август" ;;
        09) MONTH_NAME="Сентябрь" ;;
        10) MONTH_NAME="Октябрь" ;;
        11) MONTH_NAME="Ноябрь" ;;
        12) MONTH_NAME="Декабрь" ;;
        *) MONTH_NAME="$MON" ;;
    esac

    # Загружаем имена клиентов один раз
    refresh_awg_cache

    local TEXT="📅 ${MONTH_NAME} ${YEAR}

"
    local TOTAL=0
    local TMP

    TMP=$(mktemp)

    while IFS=$'\t' read -r IP TRAFFIC; do
        [ -z "$IP" ] && continue

        TRAFFIC="${TRAFFIC:-0}"

        # Не показываем клиентов без трафика
        [ "$TRAFFIC" -gt 0 ] || continue

        TOTAL=$((TOTAL + TRAFFIC))

        local NAME
        NAME="${CACHE_NAME[$IP]:-$IP}"

        printf '%020d\t%s\t%s\n' \
            "$TRAFFIC" "$IP" "$NAME" >> "$TMP"

    done < "$FILE"

    while IFS=$'\t' read -r SORTED IP NAME; do
        local TRAFFIC
        TRAFFIC="${SORTED#0}"
        TRAFFIC="${TRAFFIC:-0}"

        TEXT+="👤 ${NAME}
${IP} — $(format_bytes "$TRAFFIC")

"
    done < <(sort -r "$TMP")

    rm -f "$TMP"

    TEXT+="━━━━━━━━━━━━━━
📊 ВСЕГО: $(format_bytes "$TOTAL")"

    printf '%s' "$TEXT"
}

traffic_archive_month_markup() {
    local MONTH="$1"

    printf '%s' '{
        "inline_keyboard":[
            [
                {"text":"🔄 Обновить","callback_data":"traffic_archive_month:'"${MONTH}"'"}
            ],
            [
                {"text":"◀️ Архив","callback_data":"traffic_archive"}
            ],
            [
                {"text":"📈 Трафик","callback_data":"traffic"},
                {"text":"🏠 Меню","callback_data":"menu"}
            ]
        ]
    }'
}

traffic_history_text() {
    local IP="$1"
    local NAME

    NAME=$(get_name "$IP")
    [ -z "$NAME" ] && NAME="$IP"

    local TEXT="📈 ${NAME}

"

    local TOTAL_BYTES=0
    local COUNT=0

    for FILE in /var/lib/awg-traffic/20??-??.tsv; do
        [ -f "$FILE" ] || continue

        local MONTH
        MONTH=$(basename "$FILE" .tsv)

        local BYTES
        BYTES=$(awk -v ip="$IP" '$1 == ip {print $NF; exit}' "$FILE")

        [ -z "$BYTES" ] && BYTES=0

        local YEAR="${MONTH:0:4}"
        local MON="${MONTH:5:2}"

        local MONTH_NAME

        case "$MON" in
            01) MONTH_NAME="Январь" ;;
            02) MONTH_NAME="Февраль" ;;
            03) MONTH_NAME="Март" ;;
            04) MONTH_NAME="Апрель" ;;
            05) MONTH_NAME="Май" ;;
            06) MONTH_NAME="Июнь" ;;
            07) MONTH_NAME="Июль" ;;
            08) MONTH_NAME="Август" ;;
            09) MONTH_NAME="Сентябрь" ;;
            10) MONTH_NAME="Октябрь" ;;
            11) MONTH_NAME="Ноябрь" ;;
            12) MONTH_NAME="Декабрь" ;;
        esac

        TEXT+="📅 ${MONTH_NAME} ${YEAR} — $(format_bytes "$BYTES")
"
        TOTAL_BYTES=$((TOTAL_BYTES + BYTES))
        COUNT=$((COUNT + 1))
    done

    if [ "$COUNT" -eq 0 ]; then
        TEXT+="Нет данных"
    else
        TEXT+="
📊 Всего — $(format_bytes "$TOTAL_BYTES")"
    fi

    printf '%s' "$TEXT"
}

traffic_history_markup() {
    local IP="$1"

    printf '%s' '{
        "inline_keyboard":[
            [
                {"text":"🔄 Обновить","callback_data":"traffic_history:'"${IP}"'"}
            ],
            [
                {"text":"◀️ Клиент","callback_data":"client:'"${IP}"'"}
            ],
            [
                {"text":"👥 Клиенты","callback_data":"clients"},
                {"text":"🏠 Главное меню","callback_data":"menu"}
            ]
        ]
    }'
}

clients_text() {
    local TOTAL=0
    local ACTIVE=0
    local OFF=0
    local PAUSED=0

    while read -r IP; do
        [ -z "$IP" ] && continue

        TOTAL=$((TOTAL + 1))

        case "$(get_status "$IP")" in
            ACTIVE) ACTIVE=$((ACTIVE + 1)) ;;
            OFF) OFF=$((OFF + 1)) ;;
            PAUSED) PAUSED=$((PAUSED + 1)) ;;
        esac
    done < <(get_clients)

    cat <<TEXT
👥 КЛИЕНТЫ

Всего: ${TOTAL}
🟢 Online: ${ACTIVE}
🔴 Offline: ${OFF}
⏸ Paused: ${PAUSED}

Выбери клиента:
TEXT
}

show_clients() {
    local CHAT="$1"
    local MESSAGE_ID="${2:-}"

    # Обновляем AWG-кэш один раз перед формированием списка
    refresh_awg_cache

    local TEXT
    TEXT=$(clients_text)

    local MARKUP
    MARKUP=$(clients_markup)

    if [ -n "$MESSAGE_ID" ]; then
        edit_message "$CHAT" "$MESSAGE_ID" "$TEXT" "$MARKUP"
    else
        api -X POST "${API}/sendMessage" \
            -d "chat_id=${CHAT}" \
            --data-urlencode "text=${TEXT}" \
            --data-urlencode "reply_markup=${MARKUP}" \
        >/dev/null
    fi
}

problems_text() {
    local COUNT=0
    local TEXT="🔴 ПРОБЛЕМЫ

"

    while IFS= read -r IP; do
        [ -z "$IP" ] && continue

        local STATUS
        STATUS=$(get_status "$IP")

        # В проблемы попадают только реальные OFFLINE.
        # PAUSED и NEVER здесь никогда не показываются.
        [ "$STATUS" != "OFF" ] && continue

        local NAME
        NAME=$(get_name "$IP")
        [ -z "$NAME" ] && NAME="$IP"

        COUNT=$((COUNT + 1))

        TEXT+="🔴 ${NAME}
IP: ${IP}

"
    done < <(get_clients)

    if [ "$COUNT" -eq 0 ]; then
        TEXT+="✅ Проблем нет"
    else
        TEXT+="Всего проблем: ${COUNT}"
    fi

    printf '%s' "$TEXT"
}

problems_markup() {
    printf '%s' '{
        "inline_keyboard":[
            [
                {"text":"🔄 Обновить","callback_data":"problems"}
            ],
            [
                {"text":"👥 Клиенты","callback_data":"clients"},
                {"text":"🏠 Главное меню","callback_data":"menu"}
            ]
        ]
    }'
}

status_text() {
    local TOTAL=0
    local ACTIVE=0
    local OFF=0
    local PAUSED=0

    while read -r IP; do
        [ -z "$IP" ] && continue

        TOTAL=$((TOTAL + 1))

        case "$(get_status "$IP")" in
            ACTIVE) ACTIVE=$((ACTIVE + 1)) ;;
            OFF) OFF=$((OFF + 1)) ;;
            PAUSED) PAUSED=$((PAUSED + 1)) ;;
        esac
    done < <(get_clients)

    cat <<TEXT
📊 AWG STATUS

👥 Всего: ${TOTAL}

🟢 Online: ${ACTIVE}
🔴 Offline: ${OFF}
⏸ Paused: ${PAUSED}
TEXT
}

status_markup() {
    printf '%s' '{
        "inline_keyboard":[
            [
                {"text":"👥 Клиенты","callback_data":"clients"},
                {"text":"🔄 Обновить","callback_data":"status"}
            ],
            [
                {"text":"🏠 Главное меню","callback_data":"menu"}
