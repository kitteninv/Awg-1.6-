# =========================
# CLIENT STATUS MONITOR
# =========================

MONITOR_INTERVAL=30
MONITOR_LAST_CHECK=0
MONITOR_STATE_FILE="${STATE_DIR}/client-status"

declare -A MONITOR_STATUS

load_monitor_state() {
    MONITOR_STATUS=()

    [ -f "$MONITOR_STATE_FILE" ] || return

    while IFS='=' read -r IP STATUS; do
        [ -n "$IP" ] && [ -n "$STATUS" ] &&
            MONITOR_STATUS["$IP"]="$STATUS"
    done < "$MONITOR_STATE_FILE"
}

save_monitor_state() {
    local TMP="${MONITOR_STATE_FILE}.tmp"

    : > "$TMP"

    for IP in "${!MONITOR_STATUS[@]}"; do
        printf '%s=%s\n' "$IP" "${MONITOR_STATUS[$IP]}"
    done > "$TMP"

    mv -f "$TMP" "$MONITOR_STATE_FILE"
}

notify_status_change() {
    local IP="$1"
    local OLD="$2"
    local NEW="$3"

    # NEVER и PAUSED никогда не являются тревогой.
    if [ "$OLD" = "NEVER" ] || [ "$NEW" = "NEVER" ]; then
        return
    fi

    if [ "$OLD" = "PAUSED" ] || [ "$NEW" = "PAUSED" ]; then
        return
    fi

    local NAME
    NAME=$(get_name "$IP")
    [ -z "$NAME" ] && NAME="$IP"

    local TEXT=""

    case "$NEW" in
        ACTIVE)
            # ONLINE отправляем только после подтверждённого OFF.
            [ "$OLD" != "OFF" ] && return

            TEXT="🟢 Клиент снова ONLINE

👤 ${NAME}
IP: ${IP}

Статус: Онлайн"
            ;;

        OFF)
            # OFF отправляем только при переходе ACTIVE → OFF.
            [ "$OLD" != "ACTIVE" ] && return

            TEXT="🔴 Клиент OFFLINE

👤 ${NAME}
IP: ${IP}

Статус: Оффлайн"
            ;;

        *)
            return
            ;;
    esac

    send_message "$CHAT_ID" "$TEXT"
}

monitor_clients() {
    local NOW
    NOW=$(date +%s)

    if [ "$((NOW - MONITOR_LAST_CHECK))" -lt "$MONITOR_INTERVAL" ]; then
        return
    fi

    MONITOR_LAST_CHECK="$NOW"

    refresh_awg_cache

    local CLIENTS
    CLIENTS=$(get_clients 2>/dev/null)

    [ -z "$CLIENTS" ] && return

    local FIRST_RUN=0

    if [ ! -f "$MONITOR_STATE_FILE" ]; then
        FIRST_RUN=1
    else
        load_monitor_state
    fi

    local IP STATUS OLD

    while IFS= read -r IP; do
        [ -z "$IP" ] && continue

        STATUS=$(get_status "$IP")
        OLD="${MONITOR_STATUS[$IP]:-}"

        MONITOR_STATUS["$IP"]="$STATUS"

        if [ "$FIRST_RUN" -eq 0 ] && [ -n "$OLD" ] && [ "$OLD" != "$STATUS" ]; then
            notify_status_change "$IP" "$OLD" "$STATUS"
        fi

    done <<< "$CLIENTS"

    save_monitor_state
}

OFFSET=0

if [ -f "$OFFSET_FILE" ]; then
    OFFSET=$(cat "$OFFSET_FILE" 2>/dev/null || echo 0)
fi

while true; do


    RESPONSE=$(api "${API}/getUpdates?timeout=25&offset=${OFFSET}" || true)

    [ -z "$RESPONSE" ] && continue

    PARSED=$(printf '%s' "$RESPONSE" | python3 -c '
import sys
import json

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

for update in data.get("result", []):

    update_id = update.get("update_id")

    if update_id is None:
        continue

    chat = ""
    text = ""
    callback_id = ""
    callback_data = ""
    message_id = ""

    if "message" in update:
        msg = update["message"]

        message_id = str(msg.get("message_id", ""))

        chat_obj = msg.get("chat", {})
        chat = str(chat_obj.get("id", ""))

        text = msg.get("text", "")

    elif "callback_query" in update:

        cb = update["callback_query"]

        callback_id = str(cb.get("id", ""))
        callback_data = cb.get("data", "")

        msg = cb.get("message", {})

        message_id = str(msg.get("message_id", ""))

        chat_obj = msg.get("chat", {})
        chat = str(chat_obj.get("id", ""))

    print("UPDATE_ID=" + str(update_id))
    print("CHAT=" + chat)
    print("TEXT=" + text)
    print("CALLBACK_ID=" + callback_id)
    print("CALLBACK_DATA=" + callback_data)
    print("MESSAGE_ID=" + message_id)
    print("---")
')

    PARSED=$(printf '%s\n' "$PARSED" | awk '
        BEGIN { block="" }
        /^---$/ {
            if (block != "") {
                gsub(/\n/, "\t", block)
                print block
            }
            block=""
            next
        }
        {
            if (block != "") block=block "\n"
            block=block $0
        }
        END {
            if (block != "") {
                gsub(/\n/, "\t", block)
                print block
            }
        }
    ')

    while IFS="$(printf '\t')" read -r BLOCK; do



        [ -z "$BLOCK" ] && continue

        BLOCK_NL=$(printf '%s' "$BLOCK" | tr '\t' '\n')

        UPDATE_ID=$(printf '%s\n' "$BLOCK_NL" | sed -n 's/^UPDATE_ID=//p' | head -n1)
        CHAT=$(printf '%s\n' "$BLOCK_NL" | sed -n 's/^CHAT=//p' | head -n1)
        TEXT=$(printf '%s\n' "$BLOCK_NL" | sed -n 's/^TEXT=//p' | head -n1)
        CALLBACK_ID=$(printf '%s\n' "$BLOCK_NL" | sed -n 's/^CALLBACK_ID=//p' | head -n1)
        CALLBACK_DATA=$(printf '%s\n' "$BLOCK_NL" | sed -n 's/^CALLBACK_DATA=//p' | head -n1)
        MESSAGE_ID=$(printf '%s\n' "$BLOCK_NL" | sed -n 's/^MESSAGE_ID=//p' | head -n1)

        [ -z "$UPDATE_ID" ] && continue
        [ -z "$CHAT" ] && continue
        [ "$CHAT" != "$CHAT_ID" ] && continue

        OFFSET=$((UPDATE_ID + 1))
        echo "$OFFSET" > "$OFFSET_FILE"

        # =========================
        # CALLBACK BUTTONS
        # =========================

        if [ -n "$CALLBACK_ID" ]; then

            answer_callback "$CALLBACK_ID"

            case "$CALLBACK_DATA" in

                menu)
                    send_menu "$CHAT"
                    ;;

                clients)
                    show_clients "$CHAT" "$MESSAGE_ID"
                    ;;

                traffic)
                    refresh_awg_cache
                    edit_message                         "$CHAT"                         "$MESSAGE_ID"                         "$(traffic_text)"                         "$(traffic_markup)"
                    ;;

                traffic_archive)
                    edit_message                         "$CHAT"                         "$MESSAGE_ID"                         "$(traffic_archive_text)"                         "$(traffic_archive_markup)"
                    ;;

                traffic_archive_month:*)
                    MONTH="${CALLBACK_DATA#traffic_archive_month:}"

                    edit_message                         "$CHAT"                         "$MESSAGE_ID"                         "$(traffic_archive_month_text "$MONTH")"                         "$(traffic_archive_month_markup "$MONTH")"
                    ;;


                status)
                    edit_message \
                        "$CHAT" \
                        "$MESSAGE_ID" \
                        "$(status_text)" \
                        "$(status_markup)"
                    ;;


                  problems)
                      edit_message \
                          "$CHAT" \
                          "$MESSAGE_ID" \
                          "$(problems_text)" \
                          "$(problems_markup)"
                      ;;

                health)
                    edit_message \
                        "$CHAT" \
                        "$MESSAGE_ID" \
                        "$(health_text)" \
                        "$(health_markup)"
                    ;;

                restart_confirm)
                    edit_message \
                        "$CHAT" \
                        "$MESSAGE_ID" \
                        "$(restart_confirm_text)" \
                        "$(restart_confirm_markup)"
                    ;;

                restart)
                    RESULT=$(restart_awg)

                    edit_message \
                        "$CHAT" \
                        "$MESSAGE_ID" \
                        "${RESULT}" \
                        "$(health_markup)"
                    ;;

                client:*)
                    IP="${CALLBACK_DATA#client:}"

                    show_client \
                        "$CHAT" \
                        "$MESSAGE_ID" \
                        "$IP"
                    ;;

                traffic_history:*)
                    IP="${CALLBACK_DATA#traffic_history:}"

                    edit_message \
                        "$CHAT" \
                        "$MESSAGE_ID" \
                        "$(traffic_history_text "$IP")" \
                        "$(traffic_history_markup "$IP")"
                    ;;

                pause_confirm:*)
                    IP="${CALLBACK_DATA#pause_confirm:}"

                    edit_message \
                        "$CHAT" \
                        "$MESSAGE_ID" \
                        "$(pause_confirm_text "$IP")" \
                        "$(pause_confirm_markup "$IP")"
                    ;;

                pause:*)
                    IP="${CALLBACK_DATA#pause:}"

                    RESULT=$(pause_client "$IP")

                    edit_message \
                        "$CHAT" \
                        "$MESSAGE_ID" \
                        "${RESULT}" \
                        "$(client_markup "$IP")"
                    ;;

                resume:*)
                    IP="${CALLBACK_DATA#resume:}"

                    RESULT=$(resume_client "$IP")

                    edit_message \
                        "$CHAT" \
                        "$MESSAGE_ID" \
                        "${RESULT}" \
                        "$(client_markup "$IP")"
                    ;;

            esac

            continue
        fi

        # =========================
        # TEXT COMMANDS
        # =========================

        case "$TEXT" in

            /start)
                send_menu "$CHAT"
                ;;

            /menu)
                send_menu "$CHAT"
                ;;

            /clients)
                show_clients "$CHAT"
                ;;

            /status)
                send_message \
                    "$CHAT" \
                    "$(status_text)"
                ;;

            /health)
                send_message \
                    "$CHAT" \
                    "$(health_text)"
                ;;

        esac

    done < <(
        printf '%s\n' "$PARSED" |
        awk '
            /^UPDATE_ID=/ {
                if (block != "") print block
                block=$0
                next
            }
            {
                if (block != "")
                    block=block "\n" $0
            }
            END {
                if (block != "")
                    print block
            }
        '
    )

done
